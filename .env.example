# SECRET_KEY: chave para assinar sessions do Flask.
# Se nao definida, uma nova chave aleatoria sera gerada a cada inicializacao
# (flash messages e sessions serao perdidas ao reiniciar o servidor).
SECRET_KEY=

# DATABASE_URL: string de conexao com o banco de dados.
# Padrao: sqlite:///instance/financas.db
DATABASE_URL=

# FLASK_DEBUG: modo debug (True/False).
# Padrao: True
FLASK_DEBUG=
